{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "MetinAR": "Data Source=data/metinar-dev.db"
  },
  "Api": {
    "EnableSwagger": false
  },
  "ApiLimits": {
    "MinRadiusMeters": 1,
    "MaxRadiusMeters": 1000,
    "DefaultRadiusMeters": 250,
    "DefaultPageSize": 50,
    "MaxPageSize": 100,
    "MaxOffset": 10000,
    "MaxDisplayNameLength": 32
  },
  "PrototypePlayerDefaults": {
    "Level": 1,
    "MaxHp": 100,
    "MaxMp": 100,
    "Experience": 0
  },
  // PROTOTYPE values (owner decision D3/Q3, #33): technical anti-abuse / GPS-noise limits, not game balance.
  // Kept as configuration; override per environment, e.g. EncounterRules__MaxStartDistanceMeters=60.
  "EncounterRules": {
    "MaxStartDistanceMeters": 40,
    "AccuracyAllowanceCapMeters": 20,
    "MaxAcceptedAccuracyMeters": 50,
    "MaxFixAgeSeconds": 30,
    "MaxFutureSkewSeconds": 5,
    "EncounterTtlSeconds": 600
  },
  // PLACEHOLDERS (#71, not design decisions): first SaveGame of a player. Class choice has no UI yet; capacity 24 is
  // the ITEMS_COMBAT_SPEC §5 proposal; the starter weapon matches the client's StarterLoadout.
  "PrototypeSaveGameDefaults": {
    "ClassId": "warrior",
    "InventoryCapacity": 24,
    "StarterWeaponDefinitionId": "starter_sword"
  },
  // PROTOTYPE anti-abuse caps for client reward claims (not game balance; server-side rewards are #56).
  "SaveGameLimits": {
    "MaxBodyBytes": 1048576,
    "MaxEncounterResultsInDocument": 200,
    "MaxRewardExpPerEncounter": 100000,
    "MaxRewardTalersPerEncounter": 100000,
    "MaxRewardEntriesPerList": 10,
    "MaxRewardQuantityPerEntry": 99
  }
}
