<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>MetinAR.Server</RootNamespace>
    <AssemblyName>MetinAR.Server</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are used for OpenAPI descriptions; missing docs on every member are not an error. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT licensed (Microsoft / .NET Foundation). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- Apache-2.0. Explicit pin: the 2.1.6 native SQLite bundle pulled in transitively by
         Microsoft.Data.Sqlite 8.0.11 is flagged by GHSA-2m69-gcr7-jv3q (affects <= 2.1.11). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <!-- MIT licensed (domaindrivendev/Swashbuckle.AspNetCore). -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" LogicalName="MetinAR.Server.Persistence.Migrations.%(Filename)%(Extension)" />
    <!-- Single source of truth for the EXP curve (#71): the design table itself, shared with the Unity client. -->
    <EmbeddedResource Include="../../../docs/design/tables/exp_curve.csv" LogicalName="MetinAR.Server.Design.exp_curve.csv" Link="Design/exp_curve.csv" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MetinAR.Server.Tests" />
  </ItemGroup>
</Project>
