<Project Sdk="Microsoft.NET.Sdk">
  <!-- METINAR-008B: pure map core tests (no UnityEngine). Separate from GeoCore.Tests on purpose. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../client/Assets/MetinAR/Scripts/Location/GeoCoordinate.cs" Link="Production/GeoCoordinate.cs" />
    <Compile Include="../../client/Assets/MetinAR/Scripts/Location/GeoMath.cs" Link="Production/GeoMath.cs" />
    <Compile Include="../../client/Assets/MetinAR/Scripts/Map/Core/*.cs" LinkBase="Production/Map/Core" />
    <Compile Include="../../client/Assets/MetinAR/Scripts/Map/Osm/*.cs" LinkBase="Production/Map/Osm" />
    <!-- P8 side-by-side build target: pure save/apply/restore plan only (the Unity adapter is not compiled here). -->
    <Compile Include="../../client/Assets/MetinAR/Editor/MapPocP8BuildPlan.cs" Link="Production/Editor/MapPocP8BuildPlan.cs" />
  </ItemGroup>
</Project>
