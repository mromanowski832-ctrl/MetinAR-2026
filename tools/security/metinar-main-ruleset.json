{
  "name": "MetinAR — protected main (verified CI)",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Geo Core"
          },
          {
            "context": "Gameplay Core"
          },
          {
            "context": "Asset Pipeline"
          },
          {
            "context": "pure .NET tests (all test projects)"
          },
          {
            "context": "QA tooling (PowerShell lint + tests)"
          },
          {
            "context": "repo hygiene + docs links"
          },
          {
            "context": "PR metadata"
          },
          {
            "context": "Secret patterns in Git history and changes"
          }
        ]
      }
    }
  ]
}
