{
  "schema": 1,
  "unityVersion": "6000.6.4f1",
  "unityProject": "client",
  "testProjects": [
    "tests/GeoCore.Tests/GeoCore.Tests.csproj",
    "tests/MetinAR.QA.Tests/MetinAR.QA.Tests.csproj",
    "tests/AssetPipeline.Tests/AssetPipeline.Tests.csproj",
    "tests/MetinAR.Gameplay.Tests/MetinAR.Gameplay.Tests.csproj",
    "server/tests/MetinAR.Server.Tests/MetinAR.Server.Tests.csproj"
  ],
  "optionalTestProjectGlobs": [
    "tests/*/*.Tests.csproj",
    "server/tests/*/*.Tests.csproj",
    "client/Tests/*/*.Tests.csproj"
  ],
  "expectedBuildScenes": [
    "Assets/MetinAR/Scenes/WorldMapPrototype.unity",
    "Assets/MetinAR/Scenes/ArEncounterPrototype.unity"
  ],
  "missingScriptPrefabRoots": [
    "Assets/MetinAR"
  ],
  "smokeTests": [
    {
      "name": "WorldMapSmoke",
      "method": "MetinAR.Editor.WorldMapPrototypeSmokeTest.Run",
      "results": "Builds/metinar-004a-smoke-results.xml",
      "timeoutMinutes": 20
    },
    {
      "name": "ArSmoke",
      "method": "MetinAR.Editor.ArEncounterSmokeTest.Run",
      "results": "Builds/metinar-006-ar-smoke-results.xml",
      "timeoutMinutes": 25
    }
  ],
  "androidBuild": {
    "method": "MetinAR.Editor.MetinARAndroidDevBuild.BuildArEncounterQaApk",
    "apk": "client/Builds/Android/MetinAR-ar-encounter-qa.apk",
    "timeoutMinutes": 90,
    "expectedPackage": "com.metinar.game.qa",
    "gamePackage": "com.metinar.game",
    "auditAcceptedPackages": [
      "com.metinar.game.qa",
      "com.metinar.game"
    ],
    "protectedPackages": [
      "com.metinar.game",
      "com.metinar.game.mappoc"
    ],
    "packagesByPurpose": {
      "qa": "com.metinar.game.qa",
      "game": "com.metinar.game",
      "mappoc": "com.metinar.game.mappoc"
    },
    "unityBuildTarget": "Android",
    "arCore": {
      "note": "#31 f194aa9: an APK built while the editor active target was not Android lacks these registrations and shows \"AR niedostepne\" (Failed to load session subsystem). Registration list from the working A31 APK 8d0acee (ARCore 6.x), audit UPDATE_1 N-01.",
      "assembly": "Unity.XR.ARCore",
      "runtimeInitializeEntry": "assets/bin/Data/RuntimeInitializeOnLoads.json",
      "requiredEntries": [
        "lib/arm64-v8a/libUnityARCore.so",
        "assets/bin/Data/UnitySubsystems/UnityARCore/UnitySubsystemsManifest.json"
      ],
      "requiredRegistrations": [
        "ARCoreSessionSubsystem.RegisterDescriptor",
        "ARCoreCameraSubsystem.Register",
        "ARCorePlaneSubsystem.RegisterDescriptor",
        "ARCoreRaycastSubsystem.RegisterDescriptor",
        "ARCoreAnchorSubsystem.RegisterDescriptor",
        "ARCorePointCloudSubsystem.RegisterDescriptor",
        "ARCoreEnvironmentProbeSubsystem.Register",
        "ARCoreFaceSubsystem.RegisterDescriptor",
        "ARCoreImageTrackingSubsystem.RegisterDescriptor",
        "ARCoreOcclusionSubsystem.Register",
        "InputLayoutLoader.RegisterLayouts"
      ]
    },
    "requiredAbi": "arm64-v8a",
    "forbiddenAbis": [
      "armeabi-v7a",
      "x86",
      "x86_64"
    ],
    "requireDebuggable": true,
    "minSdk": 31
  },
  "permissions": {
    "forbidden": [
      "android.permission.ACCESS_BACKGROUND_LOCATION",
      "android.permission.READ_CONTACTS",
      "android.permission.READ_SMS",
      "android.permission.RECORD_AUDIO",
      "android.permission.READ_PHONE_STATE",
      "android.permission.READ_EXTERNAL_STORAGE",
      "android.permission.WRITE_EXTERNAL_STORAGE",
      "android.permission.MANAGE_EXTERNAL_STORAGE",
      "android.permission.SYSTEM_ALERT_WINDOW",
      "android.permission.QUERY_ALL_PACKAGES"
    ],
    "allowed": [
      "android.permission.INTERNET",
      "android.permission.ACCESS_NETWORK_STATE",
      "android.permission.ACCESS_FINE_LOCATION",
      "android.permission.ACCESS_COARSE_LOCATION",
      "android.permission.CAMERA",
      "android.permission.VIBRATE",
      "{package}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
    ]
  },
  "budgetsFile": "tools/qa/perf-budgets.json"
}
