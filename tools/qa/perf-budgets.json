{
  "schema": 1,
  "label": "PROTOTYPE GATE - technical regression gates for development builds, not final product targets",
  "baselineDevice": "Android API 31 baseline phone used for METINAR-003..006 (model recorded per report)",
  "apk": {
    "maxDevApkMB": 150,
    "warnDevApkMB": 110
  },
  "scenes": {
    "WorldMapPrototype": {
      "description": "World map (no camera/AR)",
      "minFpsAvg": 28,
      "maxFrameP95Ms": 45,
      "maxFrameSpikesPerWindow": 3,
      "maxMainP95Ms": 33,
      "maxTotalUsedMB": 450,
      "maxPssMB": 600,
      "latencyMetrics": [
        {
          "metric": "map.tile.decode",
          "maxAvgMs": 30,
          "maxP95Ms": 80,
          "required": false,
          "note": "METINAR-008B tile decode; skipped until the build reports it"
        },
        {
          "metric": "map.tile.mesh",
          "maxAvgMs": 20,
          "maxP95Ms": 50,
          "required": false,
          "note": "METINAR-008B tile mesh build; skipped until the build reports it"
        }
      ]
    },
    "ArEncounterPrototype": {
      "description": "AR encounter (camera + ARCore + one mob)",
      "minFpsAvg": 24,
      "maxFrameP95Ms": 55,
      "maxFrameSpikesPerWindow": 4,
      "maxMainP95Ms": 40,
      "maxTotalUsedMB": 650,
      "maxPssMB": 850
    },
    "HandTracking": {
      "description": "Hand-tracking inference (METINAR-007); reported via MetinARPerfProbe.Measure(MetinARPerfProbe.Metrics.HandInference)",
      "latencyMetrics": [
        {
          "metric": "hand.inference",
          "maxAvgMs": 45,
          "maxP95Ms": 70,
          "required": false
        }
      ],
      "anyScene": true
    },
    "CombinedArHandSword": {
      "description": "AR + hand tracking + sword (METINAR-007 combined scene; scene name to be confirmed when it lands)",
      "sceneNames": [
        "ArHandSwordPrototype"
      ],
      "minFpsAvg": 20,
      "maxFrameP95Ms": 66,
      "maxFrameSpikesPerWindow": 6,
      "maxMainP95Ms": 50,
      "maxTotalUsedMB": 800,
      "maxPssMB": 1000,
      "latencyMetrics": [
        {
          "metric": "hand.inference",
          "maxAvgMs": 50,
          "maxP95Ms": 80
        }
      ]
    }
  },
  "device": {
    "maxColdLaunchMs": 15000,
    "warnThermalStatus": 2,
    "failThermalStatus": 4,
    "warnBatteryTempC": 40,
    "failBatteryTempC": 45
  },
  "schemaNotes": "latencyMetrics[]: {metric, maxAvgMs, maxP95Ms, required(default true)}; legacy latencyMetric/maxLatencyAvgMs/maxLatencyP95Ms still accepted; anyScene=true evaluates the budget over samples from every scene"
}
